# ===================================================================
#  Umgebungsvariablen – Kopie als .env anlegen. NIE echte Werte committen.
# ===================================================================

# Betriebsmodus: preview (Standard) | production
# production baut nur, wenn scripts/release-check.mjs keine offenen Punkte findet.
SITE_MODE=preview

# Öffentliche Domain (ohne Slash am Ende) – überschreibt advisor.siteUrl
SITE_URL=

# --- Vorschau-Zugang (Basic Auth). Auf localhost nicht nötig. --------
PREVIEW_USER=vorschau
PREVIEW_PASSWORD=

# --- Lead-Dashboard /intern (Basic Auth, immer erforderlich) ---------
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Anfrage-Zustellung (nur Produktion) -----------------------------
LEADS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Empfänger (überschreibt advisor.leadRecipientEmail)
LEAD_TO=

# Leads zusätzlich lokal speichern (data/leads.json): file | none
# Auf Serverless-Hosting (flüchtiges Dateisystem) "none" setzen.
LEAD_STORE=file
DATA_DIR=

# --- Anonyme, cookielose Zählung: first-party | (leer = aus) ---------
ANALYTICS=

# --- Testphase -------------------------------------------------------
# Startdatum erst nach freigegebener Veröffentlichung setzen (YYYY-MM-DD)
TRIAL_START=

# Salt für das Rate-Limit (beliebiger Zufallswert)
RATE_SALT=

# Marketing-Materialien: Ziel-URL für QR-Code & Links
MARKETING_URL=
